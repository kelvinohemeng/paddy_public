# Copy to backend/.env and fill in real values. Never commit backend/.env.
# Every variable below is read in config/settings.py (or a management command).

# --- Django ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Frontend origin(s) allowed to call the API (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Used to build links in emails (verify email, reset password)
FRONTEND_URL=http://localhost:3000

# --- Database (PostgreSQL + PostGIS, required) ---
DB_NAME=paddy
DB_USER=paddy
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# --- Windows only: OSGeo4W provides GDAL/GEOS for GeoDjango ---
# OSGEO4W_ROOT=C:\OSGeo4W
# GDAL_LIBRARY_PATH=C:\OSGeo4W\bin\gdal313.dll

# --- Email (Resend) ---
RESEND_API_KEY=re_your_resend_api_key
# Must be an address on a domain verified in Resend
DEFAULT_FROM_EMAIL=hello@your-domain.com

# --- Google sign-in ---
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# --- Paystack ---
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_AGENT_PLAN_CODE=PLN_your_agent_plan
PAYSTACK_LORD_PLAN_CODE=PLN_your_lord_plan
# Price to unlock one listing, in pesewas (500 = GHS 5.00)
LISTING_UNLOCK_PRICE_PESEWAS=500

# --- Cloudflare R2 (media storage) ---
R2_STORAGE_ACCOUNT_ID=your-r2-account-id
R2_STORAGE_ACCESS_KEY_ID=your-r2-access-key-id
R2_STORAGE_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_STORAGE_BUCKET_NAME=your-bucket-name
# Public custom domain connected to the bucket (no https://)
AWS_S3_CUSTOM_DOMAIN=media.your-domain.com

# --- Optional: one-off admin creation on hosts without a shell ---
# (python manage.py create_superuser_from_env)
# DJANGO_SUPERUSER_EMAIL=admin@your-domain.com
# DJANGO_SUPERUSER_PASSWORD=change-me
