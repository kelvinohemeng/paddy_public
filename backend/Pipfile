[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
django = "*"
psycopg2-binary = "*"
python-decouple = "*"
djangorestframework = "*"
google-auth = "*"
requests = "*"
djangorestframework-simplejwt = {extras = ["blacklist"], version = "*"}
django-unfold = "*"
pillow = "*"
django-anymail = {extras = ["resend"], version = "*"}
gunicorn = "*"
whitenoise = "*"
django-cors-headers = "*"
django-storages = "*"
boto3 = "*"
django-location-field = "*"

[dev-packages]
bandit = "*"

[scripts]
# pipenv run security: Bandit (a security linter) over the app code. Tests
# and migrations are skipped: their fake passwords are all false alarms.
security = "bandit -r . -x ./*/tests.py,./*/test_*.py,./*/migrations,./staticfiles,./static"

[requires]
python_version = "3.11"
