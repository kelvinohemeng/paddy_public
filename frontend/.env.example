# Copy to frontend/.env.local and fill in real values. Never commit it.
# NEXT_PUBLIC_* values are sent to the browser, so never put secrets here.

# Django backend base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google sign-in (OAuth client ID, same as the backend's GOOGLE_CLIENT_ID).
# Leave it empty to hide the Google buttons (e.g. a domain the client doesn't allow).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Google Maps JavaScript API key (restrict it to your domains in Google Cloud)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-browser-key
# Optional: a Map ID for styled vector maps (falls back to DEMO_MAP_ID)
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Viewings (booking an in-person viewing) are hidden for the portfolio demo.
# Set to true to show the viewing UI again; unset or anything else hides it.
NEXT_PUBLIC_FEATURE_VIEWINGS=

# Password of the public demo accounts (renter+demo@ / landlord+demo@paddy.dev),
# the same value as the backend's DEMO_ACCOUNT_PASSWORD. Public on purpose:
# the login page shows it in a "Try the demo" block. Empty hides the block.
NEXT_PUBLIC_DEMO_ACCOUNT_PASSWORD=
